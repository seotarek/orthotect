{
  "name": "@seotarek/orthotect",
  "version": "1.8.0",
  "description": "The Deterministic Interface Engineering & Runtime Gate Architecture for AI Coding Agents.",
  "main": "bin/orthotect.js",
  "bin": {
    "orthotect": "bin/orthotect.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/validate-skills.mjs && python3 -m unittest discover -s tests -p 'test_*.py' && python3 gates/run_all_gates.py examples/golden-showcase",
    "test:unit": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "validate:skills": "node scripts/validate-skills.mjs",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "check:release-sync": "node scripts/check-release-sync.mjs",
    "gate:all": "python3 gates/run_all_gates.py",
    "gate:bidi": "python3 gates/gate_bidi_logical.py",
    "gate:contrast": "python3 gates/gate_contrast_wcag.py",
    "gate:fsm": "python3 gates/gate_fsm_integrity.py",
    "gate:slop": "python3 gates/gate_no_slop.py",
    "gate:cwv": "node gates/gate_cwv_budget.mjs",
    "gate:security": "python3 gates/gate_security_audit.py",
    "compile:tokens": "node bin/orthotect.js compile core/tokens --out examples/golden-showcase/tokens.css",
    "sync:core": "node scripts/sync-core-data.mjs"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "skills-sh",
    "cybersecurity",
    "sast",
    "owasp",
    "vulnerability-scanner",
    "claude-code",
    "cursor",
    "cursor-agent",
    "codex",
    "antigravity",
    "grok",
    "quality-gates",
    "code-review",
    "static-analysis",
    "linter",
    "ast",
    "design-system",
    "design-tokens",
    "dtcg",
    "w3c-dtcg",
    "accessibility",
    "wcag",
    "wcag-aaa",
    "a11y",
    "bidi",
    "rtl",
    "css-logical-properties",
    "fsm",
    "state-machine",
    "finite-state-machine",
    "core-web-vitals",
    "cls",
    "developer-tools",
    "frontend-engineering"
  ],
  "author": "Orthotect Architecture Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seotarek/orthotect.git"
  },
  "bugs": {
    "url": "https://github.com/seotarek/orthotect/issues"
  },
  "homepage": "https://seotarek.github.io/orthotect/",
  "files": [
    "bin",
    "core",
    "gates",
    "skills",
    "examples",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "knowledge",
    "COMPETITORS.md",
    "MANIFESTO.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "python": ">=3.9.0"
  },

  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
