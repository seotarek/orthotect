{
  "$schema": "../schemas/knowledge-record.schema.json",
  "id": "harmonized-palettes",
  "title": "Comprehensive Harmonized Color Palettes & Product-Specific Chromatic Architecture",
  "category": "palettes",
  "summary": "Exhaustive library of 96 industry-tailored, mathematically verified color palettes covering B2B SaaS, fintech, healthcare, dev tools, e-commerce, and public infrastructure.",
  "whenToUse": "When choosing or generating a thematic color palette for a new product, brand interface, or high-conversion application.",
  "whenNotToUse": "Do not mix disparate palette identities within a single visual hierarchy or bypass contrast token validation.",
  "rules": [
    "Every palette specifies distinct primary, secondary, CTA, canvas, text, and border tokens.",
    "CTA actions must maintain >= 4.5:1 relative luminance contrast against adjacent surfaces.",
    "Text tokens must satisfy WCAG 2.2 AA (4.5:1) for regular body and AAA (7.0:1) for critical reading.",
    "Dark and light modes must use calibrated token pairs rather than simple RGB arithmetic inversion."
  ],
  "antiPatterns": [
    "Low-contrast gray-on-gray text beneath 4.5:1 threshold",
    "Single-accent saturation overload where every button and link competes for visual prominence",
    "Uncalibrated neon CTAs on pure white backgrounds causing visual vibration",
    "Failing to support dark-mode elevation layering"
  ],
  "applicableStacks": [
    "css",
    "tailwind",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "swiftui",
    "flutter",
    "design-tokens"
  ],
  "accessibilityNotes": "All color combinations must pass CIE 1931 relative luminance verification via gate_contrast_wcag.py.",
  "provenance": "Independently synthesized from chromatic harmonies, color psychology, and WCAG 2.2 accessibility mathematics.",
  "verificationStatus": "VERIFIED_DETERMINISTIC",
  "tags": [
    "palettes",
    "color-systems",
    "chromatic-harmony",
    "wcag",
    "contrast",
    "tokens",
    "theming"
  ],
